PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=
# Postgres connection string, e.g. postgresql://localhost/spending_tracker_dev
DATABASE_URL=
# Supabase project used for sign-in (Project Settings > API Keys).
# The publishable key is browser-safe; never put the secret/service_role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional extra lock: only these emails may use the app (comma-separated).
ALLOWED_EMAILS=
# Which user the command-line scripts (get_transactions.py, connect_bank.py) act for.
LOCAL_USER_ID=
